# Copy to .env for local development. Never commit the real .env file.
NODE_ENV=development
# API Gateway listens on 3000; run the Next.js web client on 3001.
PORT=3000

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=safar_service
PG_USER=postgres
PG_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS: allow the local Next.js client (client-web) on port 3001.
CORS_ORIGIN=http://localhost:3001

# Generate the local RS256 key pair with:
# node 00-infrastructure/keys/generate-keys.js
# The generated PEM files belong in 00-infrastructure/keys and must never be committed.
# Set a passphrase only if you intentionally encrypt the generated private key.
JWT_PRIVATE_KEY_PASSPHRASE=

# Application settings
WALLET_CURRENCY=IRT
WALLET_PLATFORM_USER_ID=system-platform
