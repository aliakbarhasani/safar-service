# Copy to .env for local development. Never commit the real .env file.
NODE_ENV=development
PORT=3000

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=safar_service
PG_USER=postgres
PG_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ORIGIN=http://localhost:3000

# RS256 JWT keys. Store the real private key only in a secret manager/environment.
# For .env, escaped newlines (\n) are supported.
JWT_PRIVATE_KEY=replace-with-real-rs256-private-key
JWT_PUBLIC_KEY=replace-with-real-rs256-public-key
# فقط در صورت استفاده از کلید خصوصی رمزدار لازم است؛ هرگز مقدار واقعی را کامیت نکنید.
JWT_PRIVATE_KEY_PASSPHRASE=

# Application settings
WALLET_CURRENCY=IRT
WALLET_PLATFORM_USER_ID=system-platform
