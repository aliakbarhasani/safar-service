{
  "app": {
    "name": "سفر سرویس",
    "shortName": "سفر",
    "description": "پلتفرم جامع حمل و نقل و سفر",
    "version": "1.0.0"
  },
  "api": {
    "baseUrl": "http://localhost:3000",
    "endpoints": {
      "requestOtp": "/api/auth/request-otp",
      "verifyOtp": "/api/auth/verify-otp",
      "register": "/api/auth/register",
      "login": "/api/v1/auth/login",
      "profile": "/api/v1/profile",
      "profileUpdate": "/api/v1/profile/profile",
      "settings": "/api/v1/profile/settings",
      "refreshToken": "/api/v1/auth/refresh",
      "marketplaceProducts": "/api/v1/marketplace/products",
      "marketplaceProduct": "/api/v1/marketplace/products/:id",
      "marketplaceSellers": "/api/v1/marketplace/sellers",
      "marketplaceReviews": "/api/v1/marketplace/reviews/:productId",
      "campaignsList": "/api/v1/ads/campaigns",
      "campaign": "/api/v1/ads/campaigns/:id",
      "adsHealth": "/api/v1/ads/health"
    },
    "timeout": 10000
  },
  "theme": {
    "colors": {
      "primary": "#1e40af",
      "primaryLight": "#3b82f6",
      "secondary": "#059669",
